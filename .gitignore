cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
venv_python/

# Environment variables
.env

# Testing
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Ruff
.ruff_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# RL training outputs
training/checkpoints/*
training/runs/
ray_results/

# Keep directory structure
!training/checkpoints/.gitkeep

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Build
dist/
build/
*.egg-info/

# Temporary files
*.tmp
*.temp